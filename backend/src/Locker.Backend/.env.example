# =============================================================================
# Locker Backend - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# The .env file is loaded automatically by Program.cs on startup.
# Use __ (double underscore) as section separator for nested config keys.
# =============================================================================

# MongoDB
MONGO__CONNECTIONSTRING=mongodb+srv://admin:<password>@cluster0.xxxxx.mongodb.net/locker?retryWrites=true&w=majority&authSource=admin

# JWT
JWT__SECRET=your-secret-key-at-least-32-characters-long

# Email (Gmail SMTP)
EMAIL__USERNAME=your-email@gmail.com
EMAIL__PASSWORD=your-gmail-app-password
EMAIL__FROMADDRESS=your-email@gmail.com

# Payment Webhook
PAYMENTWEBHOOK__SECRET=your-webhook-shared-secret

# App
APP__BASEURL=https://localhost:8080

# CORS (comma-separated origins for production)
# CORS__ALLOWEDORIGINS__0=https://your-frontend.com
# CORS__ALLOWEDORIGINS__1=https://admin.your-frontend.com
