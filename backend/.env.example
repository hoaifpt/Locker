# Production environment variables for Locker.Backend
# Copy this file to .env locally if needed, but do NOT commit .env.

ASPNETCORE_ENVIRONMENT=Production

# MongoDB Atlas connection string
Mongo__ConnectionString=mmongodb+srv://admin:12345@cluster0.1zkpab0.mongodb.net/locker?retryWrites=true&w=majority
Mongo__DatabaseName=locker

# Disable seeding in production by default
Seed__Enabled=false

# Optional production CORS configuration if needed
# Cors__AllowedOrigins=https://example.com

# JWT settings can also be moved to environment variables if you want
# Jwt__Secret=your-production-jwt-secret
# Jwt__Issuer=LockerBackend
# Jwt__Audience=LockerClient